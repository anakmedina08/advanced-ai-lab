# Plantilla de las variables del gateway de OpenClaw (SPEC-077).
# Copiar como openclaw.env **en el Droplet** y llenar allí. El archivo real nunca se versiona.
#
#   cp openclaw.env.example openclaw.env && chmod 600 openclaw.env
#
# Regla: ninguna de estas llaves se pega en el chat, en el repositorio ni en un log.

# Token del gateway (R077.3). Generarlo en el servidor, no inventarlo a mano:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Modelo primario: Claude (R077.4). Es la misma llave de Anthropic del proyecto.
ANTHROPIC_API_KEY=

# Fallback. Mientras DEEPSEEK_API_KEY esté vacía se usa un segundo modelo de Anthropic
# y se declara en agents.defaults.model.fallbacks.
DEEPSEEK_API_KEY=

# Zona horaria, para que las marcas de tiempo del gateway y de la bitácora coincidan.
TZ=America/Bogota
