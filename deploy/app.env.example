# Plantilla del .env de PRODUCCIÓN (SPEC-075). NO se llena aquí: el contenido real va en la
# variable de CI tipo «File» ENV_PRODUCCION (protegida) y el job deploy la copia como app.env.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=
LLM_MAX_OUTPUT_TOKENS=1024
# Sin Ollama en el Droplet: embeddings por la API de Voyage (SPEC-080); la llave va solo en
# ENV_PRODUCCION (variable de CI), nunca aquí ni en el repositorio.
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multilingual-2
# La URL es pública: exigir código de acceso para no gastar tokens (SPEC-072)
ACCESO_CODIGO_OBLIGATORIO=1
LANGSMITH_TRACING=false
# Panel en vivo de Yellowdata (SPEC-082): la API avisa por la red interna de Docker qué tools usa
# WhatsApp (MCP) y las trazas de LangSmith. El token es el mismo de yellowdata.env y va solo en
# ENV_PRODUCCION (variable de CI), nunca aquí.
AGENT_EVENTS_URL=http://yellowdata:3000/api/agent-events
AGENT_EVENTS_TOKEN=
