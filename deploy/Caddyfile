# Proxy inverso con HTTPS automático (Let's Encrypt) · SPEC-075/076, ADR-034.
#   $DOMINIO      → Yellowdata (sitio público con el robot Yelo)
#   app.$DOMINIO  → frontend React del curso (panel del equipo)
#   api.$DOMINIO  → API FastAPI
# DOMINIO llega como variable de entorno: por defecto <ip-con-guiones>.sslip.io (no requiere DNS);
# con un subdominio propio basta cambiar la variable de CI DOMINIO.

{$DOMINIO} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy yellowdata:3000
}

app.{$DOMINIO} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy frontend:80
}

api.{$DOMINIO} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# El MCP propio es solo loopback (SPEC-078): no se expone por la URL pública.
	@mcp path /mcp /mcp/*
	respond @mcp 404
	reverse_proxy api:8000
}
