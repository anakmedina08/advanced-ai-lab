# Copie a .env (nunca se versiona) y complete.
# Proveedor: anthropic (API de pago) | deepseek (API de pago, más barata) | ollama (local, gratis)
LLM_PROVIDER=anthropic
# Clave de https://console.anthropic.com (la suscripción de Claude/Claude Code NO incluye la API)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
# Esfuerzo de razonamiento de Claude (low | medium | high | xhigh | max). Claude NO acepta temperature.
ANTHROPIC_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=1024
OLLAMA_MODEL=llama3.2:3b
# Ventana de contexto de Ollama; bájela (p. ej. 49152) si el equipo se queda sin memoria
OLLAMA_NUM_CTX=65536
MAX_CONTEXT_TOKENS=200000
# Clave de https://platform.deepseek.com (solo si LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Telemetría de agentes (hooks de Claude Code → panel en vivo de yellowdata.com.co/casos)
# Vacío = solo se escribe el registro local logs/agent-events.jsonl
AGENT_EVENTS_URL=
AGENT_EVENTS_TOKEN=

# Base vectorial (RAG): ollama (nomic-embed-text local, `ollama pull nomic-embed-text`) | voyage | fake
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
# Solo si EMBEDDINGS_PROVIDER=voyage (clave de https://dash.voyageai.com; `uv sync --extra voyage`)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multilingual-2

# LangSmith (trazas del agente). Vacío = sin trazas.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sb-asistente

# RAG con Qdrant (sb index, modos rag/agente): modelo de embeddings local y fragmentos por búsqueda
EMBEDDING_MODEL=embeddinggemma:latest
RAG_TOP_K=4
