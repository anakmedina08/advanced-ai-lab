# Gentleman Guardian Angel · revisión con IA contra AGENTS.md en cada commit
# Revisión con OpenCode (usa el proveedor/modelo configurado en OpenCode, hoy DeepSeek),
# para no depender del saldo de la API de Anthropic en cada commit.
PROVIDER="opencode"
FILE_PATTERNS="*.py,*.toml,*.yml,*.yaml,Dockerfile"
EXCLUDE_PATTERNS="uv.lock,tests/fixtures/*,.claude/*"
RULES_FILE="AGENTS.md"
STRICT_MODE="true"
TIMEOUT="300"
PR_BASE_BRANCH="main"
